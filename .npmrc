# The privacy SDK is published to GitHub Packages, not the public npm registry.
# Vercel needs a GITHUB_TOKEN env var (a PAT with read:packages) at install time.
@starkware-libs:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Do not run dependency install/postinstall scripts. An install script runs with
# full privileges at build time, before any of our code is reviewed or executed, so
# a single compromised package anywhere in the tree is enough.
#
# Nothing in the tree needs one. esbuild ships a postinstall (node install.js) but
# gets its platform binary from optionalDependencies instead — verified for both
# darwin-arm64 and the linux-x64 target Vercel builds on. If a future dependency
# genuinely needs a build step, prefer moving to pnpm, whose onlyBuiltDependencies
# allowlists per package; npm can only turn scripts on or off wholesale.
ignore-scripts=true
